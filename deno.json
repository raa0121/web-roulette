{
  "fmt": {
    "exclude": ["index.html"]
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "deploy": "deno run -A --node-modules-dir npm:wrangler deploy",
    "test": "deno test"
  },
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0",
    "@vitejs/plugin-react-swc": "npm:@vitejs/plugin-react-swc@^3.8.0",
    "react": "npm:react@^19.3.1",
    "react-dom": "npm:react-dom@^19.3.1",
    "vite": "npm:vite@^6.1.1",
    "wrangler": "npm:wrangler@^4.167.0"
  }
}
